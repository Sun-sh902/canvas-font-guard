{
  "manifest_version": 3,
  "name": "Canvas Font Guard",
  "version": "1.1.0",
  "description": "Reduce the detectability of known Chinese and vendor fonts in Canvas, per site or across all sites.",
  "minimum_chrome_version": "102",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "Canvas Font Guard",
    "default_popup": "popup.html"
  }
}
