{
  "manifest_version": 3,
  "name": "Canvas Font Guard",
  "version": "1.1.0",
  "description": "按站点或全站弱化 Canvas 中已知中文与厂商字体的可探测性。",
  "minimum_chrome_version": "102",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "Canvas 字体保护",
    "default_popup": "popup.html"
  }
}
